# --- Copia a backend/.env y ajusta valores ---

NODE_ENV=development
PORT=3333
HOST=localhost
LOG_LEVEL=info

# Generar con: node ace generate:key
APP_KEY=
APP_URL=http://localhost:3333

SESSION_DRIVER=cookie

# PostgreSQL (coherente con docker-compose.yml en la raíz)
DB_HOST=localhost
DB_PORT=5432
DB_USER=creds
DB_PASSWORD=creds_secret
DB_DATABASE=creds_db

# JWT: cadena larga y aleatoria (mínimo recomendado 32 caracteres)
JWT_SECRET=cambiar-por-secreto-largo-y-aleatorio-minimo-32-chars

# AES-256: exactamente 64 caracteres hex (32 bytes)
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Frontend: opcional (si no usas proxy de Vite) ---
# VITE_API_URL=http://localhost:3333
